DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecommerce_customer_support
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-32-character-random-secret

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_STARTTLS=true

# Local filesystem ingestion storage. The default is ./ingestion.
INGESTION_DIR=ingestion
INGESTION_MAX_UPLOAD_BYTES=20971520

# Gemini + Pinecone document embedding pipeline.
# The Pinecone index must already exist with cosine metric and 768 dimensions.
GOOGLE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=customer-support-knowledge
PINECONE_NAMESPACE=customer-support
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
PINECONE_METRIC=cosine
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=200
