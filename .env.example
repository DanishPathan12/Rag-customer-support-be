# Required by docker-compose.yml. Use a unique, strong password on a server.
POSTGRES_DB=ecommerce_customer_support
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Used for local, non-Docker runs. Docker Compose overrides this to use the
# private `postgres` service above.
DATABASE_URL=postgresql+psycopg://ecommerce_app:replace-with-a-long-random-database-password@localhost:5432/ecommerce_customer_support
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-32-character-random-secret

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_STARTTLS=true

# Comma-separated browser origins. Replace this with the public frontend URL on
# a server; do not include a trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local filesystem ingestion storage. The default is ./ingestion.
INGESTION_DIR=ingestion
INGESTION_MAX_UPLOAD_BYTES=20971520

# Gemini + ChromaDB document embedding pipeline.
# On a server, start the complete stack with: docker compose up -d --build
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
# The free Gemini tier permits 100 embedding requests per minute.
GEMINI_EMBEDDING_BATCH_SIZE=100
GEMINI_EMBEDDING_MAX_RETRIES=3
GEMINI_EMBEDDING_MIN_REQUEST_INTERVAL_SECONDS=0.7
# Grounded answer generation after ChromaDB similarity search.
GEMINI_RESPONSE_MODEL=gemini-3.8-flash
GEMINI_RESPONSE_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_RESPONSE_MAX_OUTPUT_TOKENS=512
GEMINI_RESPONSE_TEMPERATURE=0.1
GEMINI_RESPONSE_MAX_RETRIES=2
GEMINI_RESPONSE_RETRY_DELAY_SECONDS=1
# These values are for local, non-Docker runs. Docker Compose overrides them
# to use the private `chromadb` service.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION_NAME=customer-support-knowledge
RAG_TOP_K=4
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=200
