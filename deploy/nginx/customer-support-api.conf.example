# Replace YOUR_API_DOMAIN before enabling this file, for example
# api.support.example.com. Certbot will add the HTTPS server block after it
# validates this HTTP virtual host.
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_API_DOMAIN;

    # Slightly above the backend's default 20 MiB ingestion upload limit.
    client_max_body_size 25m;

    # The Docker Compose API service must bind to 127.0.0.1:8000. PostgreSQL
    # and ChromaDB remain private to the Docker network and are never proxied.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
